# Neo4j Database Configuration
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# Pinecone Credentials
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=vectordb

# Mistral AI Keys (Dual-Key Support for Ingestion & Load Balancing)
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_API_KEY_1=your_mistral_api_key_1
MISTRAL_API_KEY_2=your_mistral_api_key_2
MISTRAL_MODEL=ministral-8b-latest

# Tavily Cinema Search Key
TAVILY_API_KEY=your_tavily_api_key

# Ingestion Limit
DATASET_INGESTION_LIMIT=40000
